{
  "name": "otherwise-clients",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test extension/tests/*.test.js && python3 -m unittest discover -s tests -v",
