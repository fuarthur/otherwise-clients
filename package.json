    "build": "python3 scripts/build_extension.py",
    "test:ui": "node scripts/test_ui_browser.mjs",
    "test:guide": "node scripts/test_getting_started_browser.mjs",
    "test:themes": "node scripts/test_theme_browser.mjs",
    "test:galaxy": "node scripts/test_galaxy_browser.mjs",
    "test:focus": "node scripts/test_focus_view_browser.mjs",
    "test:backup": "node scripts/test_backup_browser.mjs",
    "test:usability": "node scripts/test_usability_browser.mjs",
    "test:exploration-review": "node scripts/test_exploration_review_browser.mjs",
    "test:interest-draft": "node scripts/test_interest_draft_browser.mjs",
    "test:galaxy-tour": "node scripts/test_galaxy_tour_browser.mjs",
    "test:stats": "node scripts/test_stats_browser.mjs",
    "test:browser:critical": "npm run test:guide && npm run test:backup && npm run test:usability && npm run test:interest-draft"
  }
}
